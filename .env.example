# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Create the DB with: createdb amina
DATABASE_URL="postgresql://localhost:5432/amina"

# Google AI Studio key used only for Gemini embeddings
GEMINI_API_KEY="your-gemini-api-key"

# ─── Ollama (local LLM inference) ─────────────────────────────────────────────
# URL of your Ollama instance. For a cloud GPU box: http://<box-ip>:11434
OLLAMA_HOST="http://localhost:11434"

# Primary reasoning model for copilot/planning (cloud or local)
AMINA_MAIN_MODEL="glm-5.2:cloud"

# Lightweight local fallback model when main is unavailable
AMINA_LOCAL_FALLBACK_MODEL="qwen3.6"

# Embedding model — nomic-embed-text produces 768-dim vectors, runs on CPU
AMINA_EMBEDDING_MODEL="gemini-embedding-2"
AMINA_EMBEDDING_DIMENSION="3072"

# ─── Legacy env var aliases (still supported, lower priority) ─────────────────
# OLLAMA_MODEL="qwen2.5:72b"

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
