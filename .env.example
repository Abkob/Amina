# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Create the DB with: createdb amina
DATABASE_URL="postgresql://localhost:5432/amina"

# Google AI Studio key used only for Gemini embeddings
GEMINI_API_KEY="your-gemini-api-key"

# ─── Ollama (local LLM inference) ─────────────────────────────────────────────
# URL of your Ollama instance. For a cloud GPU box: http://<box-ip>:11434
OLLAMA_HOST="http://localhost:11434"

# Primary reasoning model for copilot/planning (cloud or local)
AMINA_MAIN_MODEL="gemini-3.6-flash"

# Lightweight local fallback model when main is unavailable
AMINA_LOCAL_FALLBACK_MODEL="qwen3.6"

# Optional fast cloud fallback for large prompts when the primary is unavailable.
# Create a key at build.nvidia.com and keep the real value only in your local .env.
NVIDIA_API_KEY="your-nvidia-api-key"
NVIDIA_API_BASE="https://integrate.api.nvidia.com/v1"
AMINA_NVIDIA_NEMOTRON_MODEL="nvidia/nemotron-3-super-120b-a12b"
AMINA_NVIDIA_DEEPSEEK_MODEL="deepseek-ai/deepseek-v4-pro"
AMINA_NVIDIA_FALLBACK_MODEL="deepseek-ai/deepseek-v4-pro"
AMINA_NVIDIA_TIMEOUT_MS="90000"
# Nemotron and DeepSeek have separate thinking switches because their NVIDIA
# chat templates use different keys. DeepSeek defaults to the requested
# non-thinking mode even when Nemotron thinking is enabled.
AMINA_NVIDIA_THINKING="false"
AMINA_DEEPSEEK_THINKING="false"
AMINA_NVIDIA_REASONING_BUDGET="4096"
AMINA_NVIDIA_TEMPERATURE="1"
AMINA_NVIDIA_TOP_P="0.95"

# When false, Copilot always lets the full chat model interpret the turn before
# deterministic formatters/planners run. Deterministic schedule math remains enabled.
AMINA_COPILOT_DETERMINISTIC_FAST_PATHS="true"

# Embedding model — nomic-embed-text produces 768-dim vectors, runs on CPU
AMINA_EMBEDDING_MODEL="gemini-embedding-2"
AMINA_EMBEDDING_DIMENSION="3072"

# ─── Legacy env var aliases (still supported, lower priority) ─────────────────
# OLLAMA_MODEL="qwen2.5:72b"

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Optional Codex background specialist. It is deliberately off by default and
# starts read-only with network disabled when enabled.
AMINA_CODEX_WORKER_ENABLED=false
# CODEX_API_KEY=
# AMINA_CODEX_MODEL=
